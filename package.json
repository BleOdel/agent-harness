{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run build && npm test",
    "verify:boundary": "node --experimental-strip-types src/verify-boundary.ts",
    "work": "node --experimental-strip-types src/work.ts",
    "verify:gates": "node --test --experimental-strip-types test/pipeline.test.ts",
    "verify:reviewer": "node --experimental-strip-types src/verify-reviewer.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
