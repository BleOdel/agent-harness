import test from 'node:test';
import assert from 'node:assert/strict';
import {mkdtemp, rm, readFile} from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import store from '../src/store.cjs';
test('notes persist in order and blank input leaves saved data unchanged', async t => {
  const root = await mkdtemp(path.join(os.tmpdir(), 'notes-'));
  t.after(() => rm(root, {recursive:true, force:true}));
  const file = path.join(root, 'notes.json');
  assert.deepEqual(await store.load(file), []);
  await store.add(file, ' First thought '); await store.add(file, 'Second');
  assert.deepEqual(await store.load(file), ['First thought', 'Second']);
  const before = await readFile(file, 'utf8');
  await assert.rejects(store.add(file, '   '), /Write a note/);
  assert.equal(await readFile(file, 'utf8'), before);
});
