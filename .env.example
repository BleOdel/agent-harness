# Copy to .env and fill in. Nothing here is read automatically -- the
# harness reads the environment, so source this file or export the values:
#
#   set -a && . ./.env && set +a
#
# Every required value is refused loudly rather than defaulted, because a
# missing setting that degrades into a default is how a run proceeds less
# safely than the operator believes.

# ---------------------------------------------------------------- required

# The container image, as an immutable sha256 id. A tag is refused: tags
# move, ids do not, and the containment argument rests on the image being
# the one that was verified.
#
# This is the digest of node:26.5.0-bookworm-slim. To pull and pin it:
#
#   docker pull node@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb
#
HARNESS_IMAGE_ID=sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb

# The installed Pi coding agent package. Mounted read-only into the
# container; the harness never installs anything itself.
#
#   npm install -g @earendil-works/pi-coding-agent
#   npm root -g            # the directory below is <that>/@earendil-works/pi-coding-agent
#
HARNESS_PI_PACKAGE=/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent

# Pi's own data directory, holding its provider credential. Mounted
# writable, so it must not be inside any project you point the harness at.
HARNESS_AGENT_DIR=/Users/you/.pi/agent

# ---------------------------------------------------------------- optional
#
# Every value below may be left empty. Empty is treated as unset, not as
# an empty string -- a distinction that once cost a long debugging
# session, because an empty test command made Docker run the image's
# default entrypoint, which exits 0 silently and looks like a suite that
# asserts nothing.

# A directory of skills to load into the builder, read-only. Each skill is
# a directory containing SKILL.md. The reviewer never gets them: its job
# is fixed, and a skill could redefine what it finds acceptable.
#
# Must be outside any project you work on -- a model that can edit its own
# instructions has none.
#
#   git clone https://github.com/mattpocock/skills /tmp/skills
#   cp -R /tmp/skills/skills/engineering/{tdd,domain-modeling} ~/Developer/agent-skills
#
HARNESS_SKILLS=

# Which provider Pi should use. Whatever you have authenticated with
# `pi` itself; see the keys in $HARNESS_AGENT_DIR/auth.json.
HARNESS_PROVIDER=

# A specific model, if you do not want the provider's default.
HARNESS_MODEL=

# The project to work on. Defaults to the current directory.
HARNESS_PROJECT=

# Docker executable, if it is not here.
HARNESS_DOCKER=/usr/local/bin/docker

# How the project runs its tests. Defaults to `npm test`.
HARNESS_TEST_COMMAND=

# Ceilings, in seconds. 900 and 300 by default.
HARNESS_AGENT_TIMEOUT=
HARNESS_GATE_TIMEOUT=

# Blast radius for one run. 40 files and 4000 lines by default. A ceiling
# that fires on ordinary work teaches you to raise it without reading it.
HARNESS_MAX_FILES=
HARNESS_MAX_LINES=
