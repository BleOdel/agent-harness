{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run build && npm test",
    "verify:boundary": "node --experimental-strip-types src/verify-boundary.ts",
    "verify:skills": "node src/verify-skills.ts",
    "work": "node --experimental-strip-types src/cli.ts work",
    "verify:candidates": "node src/verify-candidates.ts",
    "verify:gates": "node --experimental-strip-types src/verify-gates.ts",
    "verify:reviewer": "node --experimental-strip-types src/verify-reviewer.ts",
    "undo": "node --experimental-strip-types src/cli.ts undo",
    "add": "node --experimental-strip-types src/cli.ts add",
    "look": "node --experimental-strip-types src/cli.ts look",
    "show": "node --experimental-strip-types src/cli.ts show",
    "harness": "node --experimental-strip-types src/cli.ts",
    "plan": "node --experimental-strip-types src/cli.ts plan",
    "verify:team": "node src/verify-team.ts",
    "demo:team": "node src/demo-team.ts",
    "verify:planning": "node src/verify-planning.ts",
    "verify:hardening": "node src/verify-hardening.ts",
    "verify:adapters": "node src/verify-adapters.ts",
    "verify:python": "node src/verify-python.ts",
    "verify:jobs": "node src/verify-jobs.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "harness": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    ".env.example",
    "profiles"
  ]
}
